rules_version = '2';

// Everything the app writes lives under users/{uid}/... , so ownership can be enforced
// once per subtree instead of needing a per-document owner field (the Postgres RLS
// equivalent this app used to have with Supabase — see git history for that version).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;

      match /workplaces/{workplaceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /timelists/{timelistId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /entries/{entryId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
  }
}
